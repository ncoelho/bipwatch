---
// Site shell from the page templates spec: logo, segmented nav with the
// current page filled, search (Pagefind, built after the site), and the
// sources footer. Nav items appear once their page exists (New drafts and
// What needs doing across BIPs are not built yet).
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Which nav item is the current page. */
  current?: 'week' | 'proposals' | 'data';
}
const { title, description = 'An open layer of data, metadata and evidence on top of the Bitcoin BIP repository.', current } = Astro.props;
const NAV = [
  { key: 'week', label: 'This week', href: '/' },
  { key: 'proposals', label: 'Proposals', href: '/proposals/' },
  { key: 'data', label: 'Open data', href: '/api/bips.json' },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400;500;600&display=swap" />
    <link rel="alternate" type="application/json" href="/api/bips.json" title="BipWatch open data" />
  </head>
  <body>
    <header class="top" data-pagefind-ignore="all">
      <div class="shell bar">
        <a class="mark" href="/">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--info)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          BipWatch
        </a>
        <nav aria-label="Main">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="search" id="search" role="search" aria-label="Search BIPs and discussions"></div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="shell foot" data-pagefind-ignore="all">
      <span>Built from bitcoin/bips, its pull requests, Delving Bitcoin and the bitcoin-dev list. Every item links to its source. Data is CC0.</span>
      <span class="links"><a href="/api/bips.json">Open data</a><a href="https://github.com/ncoelho/bipwatch">How we curate</a></span>
    </footer>
    <script is:inline>
      // Pagefind indexes the built site (npm run build); in dev there is no
      // index and the box stays empty.
      (function () {
        var box = document.getElementById('search');
        if (!box) return;
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        var s = document.createElement('script');
        s.src = '/pagefind/pagefind-ui.js';
        s.onload = function () {
          document.head.appendChild(css);
          new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false, translations: { placeholder: 'Search BIPs and discussions' } });
        };
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>

<style>
  .top { padding-top: env(safe-area-inset-top, 0px); }
  .bar { display: flex; align-items: center; gap: 12px 28px; flex-wrap: wrap; padding-block: 16px; }
  .mark { display: flex; align-items: center; gap: 9px; color: var(--fg); text-decoration: none; font-weight: 650; font-size: 17px; letter-spacing: -0.01em; }
  nav ul { list-style: none; margin: 0; padding: 4px; display: flex; gap: 2px; flex-wrap: wrap; font-size: 14px; background: var(--panel); border-radius: 12px; }
  nav a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 9px; color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--fg); }
  nav a[aria-current='page'] { background: var(--fg); color: #000; font-weight: 600; }
  main { padding-block: 28px 64px; }
  .search { margin-left: auto; flex: 0 1 320px; min-width: 180px; position: relative; z-index: 5;
    --pagefind-ui-scale: 0.8; --pagefind-ui-primary: var(--link); --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--panel); --pagefind-ui-border: var(--line-strong); --pagefind-ui-tag: var(--card);
    --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 12px; --pagefind-ui-font: var(--sans); }
  .search :global(.pagefind-ui__drawer) { position: absolute; right: 0; width: min(560px, calc(100vw - 40px)); max-height: 70vh; overflow-y: auto; background: var(--panel); border-radius: 14px; padding: 0 16px; box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6); }
  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 20px;
    border-top: 1px solid var(--line); padding-block: 20px calc(28px + env(safe-area-inset-bottom, 0px));
    color: var(--faint); font-size: 13px;
  }
  .links { display: flex; gap: 16px; }
</style>
