---
// One open-work item: kind, status, who raised it and when, the spec version
// it was raised against, then the statement and its quoted source.
import type { Claim } from '@bipwatch/data';
import Source from './Source.astro';
import { WORK_KIND_LABEL, isStale, versionLabel } from '../lib/view.ts';

interface Props { claim: Claim; current?: string; }
const { claim: c, current } = Astro.props;
const STATUS_PILL: Record<string, string> = { open: 'accent', addressed: 'good', disputed: 'warn', unknown: '' };
---
<li id={c.id}>
  <div class="top">
    <span class="kind">{WORK_KIND_LABEL[c.kind]}</span>
    {c.status && c.status !== 'open' && <span class:list={['pill', STATUS_PILL[c.status]]}>{c.status}</span>}
    {c.subject && <span class="by">raised by <b>{c.subject.name}</b></span>}
    {c.source.date && <span class="when mono tnum">{c.source.date}</span>}
    {c.applies_to_version && !c.part_of && <span class="ver">{versionLabel(c.applies_to_version)}</span>}
    {c.status !== 'addressed' && !c.part_of && isStale(c.applies_to_version, current) && (
      <span class="flag" title={`The spec is now at v${current}`}>spec changed since</span>
    )}
  </div>
  <p>{c.statement}</p>
  <Source claim={c} />
</li>

<style>
  li { padding: 14px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; scroll-margin-top: 24px; min-width: 0; }
  li:target { background: var(--accent-soft); padding-inline: 12px; border-radius: 8px; }
  p { font-size: 14px; }
  .top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 13px; }
  .kind { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--faint); }
  .by { color: var(--muted); }
  .by b { color: var(--fg); font-weight: 500; }
  .when, .ver { font-size: 12px; color: var(--faint); }
  .flag { font-family: var(--mono); font-size: 10.5px; padding: 1px 6px; border-radius: 4px; border: 1px solid var(--warn); color: var(--warn); }
</style>
