---
// Lifecycle bar: Idea → Draft → Complete → Deployed, or Closed. The current
// step is filled blue; the others are outlined. The right side says when the
// BIP has held its status (status_since, from the spec's git history) and
// when it was assigned.
import type { BipRecord } from '@bipwatch/data';
import { LIFECYCLE, lifecycleStep, roughAge } from '../../lib/view.ts';

interface Props { bip: BipRecord; }
const { bip } = Astro.props;
const now = lifecycleStep(bip.status);
const steps = [...LIFECYCLE, 'Closed'] as const;
const month = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<nav class="life" aria-label="Lifecycle stage">
  <ol>
    {steps.map((s, i) => (
      <>
        {i > 0 && (s === 'Closed' ? <li class="or" aria-hidden="true">or</li> : <li class="join" aria-hidden="true"></li>)}
        <li class:list={['step', { now: s === now }]} aria-current={s === now ? 'step' : undefined}>
          <span class="dot" aria-hidden="true"></span>{s}
        </li>
      </>
    ))}
  </ol>
  <div class="when">
    {bip.status_since
      ? <span>{bip.status} for <strong>{roughAge(bip.status_since)}</strong></span>
      : <span>Official status <strong>{bip.status}</strong></span>}
    {bip.assigned && <span class="faint">assigned {month(bip.assigned)}</span>}
  </div>
</nav>

<style>
  .life { display: flex; align-items: center; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; margin-top: 24px; padding: 12px 16px; background: var(--panel); border-radius: 14px; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .step { display: flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 999px; font-size: 13px; color: var(--faint); background: var(--panel); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .step .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .step.now { background: var(--info); color: #06101F; font-weight: 600; box-shadow: none; }
  .step.now .dot { background: #06101F; }
  .join { width: 14px; height: 1px; background: #3A3A40; }
  .or { font-size: 12px; color: #5A5A63; padding: 0 2px; }
  .when { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; flex: 0 1 340px; min-width: 220px; color: var(--fg-2); }
  .when strong { color: var(--fg); }
  .faint { color: var(--faint); }
</style>
