---
// "What it needs" tab (page templates spec): the needs cards, then the work
// view (area bars, or the piece × area grid when open work spans two or more
// pieces), then the list with a detail panel.
//
// Static first: every card, bar, cell, row and item detail is in the HTML;
// without JavaScript the rows show their full detail. explorer.ts adds
// filtering by dimension, area and piece, selection, "show addressed", and
// keeps all of it in the URL (#needs?dim=&area=&piece=&item=&done=1).
import { NEED_AREAS, NEED_DIMENSIONS, type BipBundle } from '@bipwatch/data';
import Dots from '../Dots.astro';
import {
  AREA_LABEL, DIMENSION_LABEL, SOURCE_LABEL, WORK_KIND_LABEL,
  isPending, isStale, versionLabel, workModel,
} from '../../lib/view.ts';

interface Props { bundle: BipBundle; }
const { bundle } = Astro.props;
const { bip, needs } = bundle;
const m = workModel(bundle);
const byId = new Map(bundle.claims.map((c) => [c.id, c]));
const openPieces = m.pieces.filter((p) => p.open > 0);
const itself = `BIP ${bip.number} itself`;
const onlyItself = m.pieces.length === 1 && m.pieces[0].name === itself;
const maxArea = Math.max(1, ...m.areas.map((a) => a.open + a.addressed));
const gridAreas = m.areas.filter((a) => a.open > 0);
const maxCell = Math.max(1, ...openPieces.flatMap((p) => gridAreas.map((a) => m.cell(p.name, a.area))));
const shade = (n: number) => (n === 0 ? '' : ['s1', 's2', 's3', 's4'][Math.min(3, Math.ceil((n / maxCell) * 4) - 1)]);
const top = openPieces[0];
const lede = onlyItself
  ? `All ${m.items.length} items are about BIP ${bip.number} itself.`
  : top && top.name !== itself
    ? `${top.name} has the most open work (${top.open} of ${m.open}); ${m.pieces.find((p) => p.name === itself)?.open ?? 0} open items are about BIP ${bip.number}'s own text.`
    : `Most open work is about BIP ${bip.number} itself, across ${openPieces.length} pieces.`;
const dimAreas = (d: (typeof NEED_DIMENSIONS)[number]) => NEED_AREAS[d].filter((a) => m.areas.some((x) => x.area === a));
const kindMark = (k: string) => (k === 'objection' ? 'sq' : k === 'open-question' ? 'dia' : 'bar');
const msgLink = (url: string) => url;
---
{needs && (
  <section class="panel" id="needs-cards" aria-labelledby="h-needs-cards">
    <div class="head">
      <h2 id="h-needs-cards">What it needs <span class="sub">· 0 to 5, where 5 means no help needed</span></h2>
      {isPending(needs) && <span class="pill warn">Generated {needs.assessed} · pending review</span>}
    </div>
    <p class="lede">Summarised from the {bundle.claims.length} claims on this page. Pick a card to see the work behind it.</p>
    <div class="cards" role="group" aria-label="Needs by dimension">
      {NEED_DIMENSIONS.map((d) => {
        const x = needs.dimensions[d];
        const areas = dimAreas(d);
        return (
          <div class:list={['card', { unscored: x.score === null }]} data-card={d} data-areas={NEED_AREAS[d].join(' ')} data-evidence={x.evidence.join(' ')} data-label={DIMENSION_LABEL[d]}>
            <button type="button" class="card-btn" data-dim={d} aria-pressed="false">
              <span class="card-t">{DIMENSION_LABEL[d]}</span>
              <span class="card-s">{x.score === null && <span class="ns">not scored</span>}<Dots score={x.score} /></span>
            </button>
            <p>{x.rationale}</p>
            {areas.length > 0 && (
              <div class="chips">
                <span class="k">Work</span>
                {areas.map((a) => {
                  const r = m.areas.find((y) => y.area === a)!;
                  return (
                    <a href={`#needs?area=${a}`} data-area={a} class:list={['wchip', { hot: r.open > 0 }]}>
                      {AREA_LABEL[a]} <span class="mono">{r.open ? `${r.open} open` : `none open · ${r.addressed} addressed`}</span>
                    </a>
                  );
                })}
              </div>
            )}
            {x.evidence.length > 0 ? (
              <div class="chips">
                <span class="k">Based on</span>
                {x.evidence.map((id, i) => {
                  const c = byId.get(id);
                  // Stances live in Positions, work items here; anything else
                  // (implementations, problems, evidence) by its own anchor.
                  const tab = c?.kind === 'stance' ? 'positions' : c && ['task', 'open-question', 'objection'].includes(c.kind) ? 'needs' : '';
                  const href = tab ? `#${tab}?item=${encodeURIComponent(id)}` : `#${encodeURIComponent(id)}`;
                  return <a class="ev" href={href} data-item={id} data-tab={tab || undefined} title={c?.statement ?? id}>{i + 1}</a>;
                })}
              </div>
            ) : (
              <div class="none">No claims recorded yet.</div>
            )}
          </div>
        );
      })}
    </div>
  </section>
)}

{m.items.length > 0 && (
  <section class="panel" id="work" aria-labelledby="h-work" data-explorer="work" data-default-tab="needs">
    <div class="head">
      <h2 id="h-work">What needs doing <span class="sub">· {m.open} open · {m.addressed} already addressed</span></h2>
    </div>
    <div class="row">
      <p class="lede">Raised in public discussion, by type of work{m.useGrid ? ' and by the piece it belongs to' : ''}. <strong>{lede}</strong></p>
      <button type="button" class="clear" data-clear hidden>Show all ✕</button>
    </div>

    {m.useGrid ? (
      <>
        <div class="area-chips" role="group" aria-label="Types of work">
          {m.areas.map((a) => (
            <button type="button" class="achip" data-area={a.area} aria-pressed="false">{AREA_LABEL[a.area]} <span class="mono">{a.open}</span></button>
          ))}
        </div>
        <div class="scroll">
          <table class="grid">
            <caption class="sr">Open items by piece and type of work</caption>
            <thead>
              <tr>
                <th scope="col" class="corner">Open items by piece</th>
                {gridAreas.map((a) => <th scope="col">{AREA_LABEL[a.area]}</th>)}
              </tr>
            </thead>
            <tbody>
              {openPieces.map((p) => (
                <tr>
                  <th scope="row"><button type="button" class="prow" data-piece={p.name} aria-pressed="false"><span class="pn">{p.name}</span><span class="mono">{p.open}</span></button></th>
                  {gridAreas.map((a) => {
                    const n = m.cell(p.name, a.area);
                    return (
                      <td>
                        {n > 0 ? (
                          <button type="button" class:list={['cell', shade(n)]} data-piece={p.name} data-area={a.area} aria-label={`${p.name}, ${AREA_LABEL[a.area]}: ${n} open`}>{n}</button>
                        ) : <span class="cell empty" aria-hidden="true"></span>}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="legend"><span>Fewer</span><span class="ramp" aria-hidden="true"><i class="s1"></i><i class="s2"></i><i class="s3"></i><i class="s4"></i></span><span>More open items</span><span class="faint">Pick a row, a column or a cell to filter.</span></div>
      </>
    ) : (
      <>
        <div class="bars" role="group" aria-label="Types of work">
          {m.areas.map((a) => (
            <button type="button" class="barrow" data-area={a.area} aria-pressed="false">
              <span class="bl"><span class="bt">{AREA_LABEL[a.area]}</span><span class="bm">{a.open} open · {a.addressed} addressed</span></span>
              <span class="track" aria-hidden="true">
                <span class="o" style={`flex-basis:${((a.open / maxArea) * 100).toFixed(1)}%`}></span>
                <span class="d" style={`flex-basis:${((a.addressed / maxArea) * 100).toFixed(1)}%`}></span>
              </span>
              <span class:list={['bn', 'mono', { hot: a.open > 0 }]}>{a.open}</span>
            </button>
          ))}
        </div>
        <div class="legend"><span class="sw o"></span>Open<span class="sw d"></span>Addressed{onlyItself && <span class="faint">All work belongs to BIP {bip.number} itself, so this shows types of work.</span>}</div>
      </>
    )}

    <div class="split">
      <div class="listcol">
        <div class="listhead">
          <span class="count" data-count>{m.open} open items</span>
          {m.addressed > 0 && <button type="button" class="done" data-done aria-pressed="false">Show {m.addressed} addressed</button>}
        </div>
        <ol class="list">
          {m.items.map((c) => {
            const open = c.status !== 'addressed';
            const piece = m.pieceOf(c);
            const stale = open && !c.part_of && isStale(c.applies_to_version, bip.version);
            return (
              <li id={c.id} data-row data-area={c.area ?? ''} data-piece={piece} data-open={open ? '1' : '0'}>
                <button type="button" class="rowbtn" data-select={c.id}>
                  <span class:list={['mark', kindMark(c.kind), { closed: !open }]} aria-hidden="true"></span>
                  <span class="rt">
                    <span>{c.statement}</span>
                    <span class="meta">{WORK_KIND_LABEL[c.kind]} · {c.area ? AREA_LABEL[c.area] : 'no type'}{m.useGrid ? ` · ${piece}` : ''} · {c.subject?.name} · {c.source.date ?? 'undated'}{open ? '' : ' · addressed'}</span>
                  </span>
                </button>
                <div class="detail">
                  <div class="eyebrow2">{piece}</div>
                  <div class="dchips">
                    <span class="pill">{WORK_KIND_LABEL[c.kind]}</span>
                    {c.area && <span class="pill">{AREA_LABEL[c.area]}</span>}
                    <span class:list={['pill', open ? 'accent' : 'good']}>{c.status}</span>
                    {isPending(c) && <span class="pill warn">pending review</span>}
                  </div>
                  <div class="dt">{c.statement}</div>
                  {c.source.quote && (
                    <blockquote>“{c.source.quote}”{c.source.verified && <span class="matched">quote matched</span>}</blockquote>
                  )}
                  <div class="who">Raised by <strong>{c.subject?.name}</strong> · {c.source.date ?? 'undated'} · {SOURCE_LABEL[c.source.type]}{c.source.title ? ` · ${c.source.title}` : ''}</div>
                  {stale && <div class="stale">Raised on {versionLabel(c.applies_to_version)}. The spec is now at v{bip.version}; check it still applies.</div>}
                  <a href={msgLink(c.source.url)} rel="noopener">Open the message</a>
                </div>
              </li>
            );
          })}
        </ol>
        <div class="nothing" data-nothing hidden>Nothing open here. <button type="button" class="linkbtn" data-done-inline>Show what was addressed</button></div>
      </div>
      <aside class="side" aria-live="polite" data-panel hidden></aside>
    </div>
  </section>
)}

<style>
  .panel { background: var(--panel); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 12px; scroll-margin-top: 16px; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 8px 16px; flex-wrap: wrap; }
  h2 { font-size: 17px; }
  .sub { font-weight: 400; color: var(--faint); font-size: 14px; }
  .lede { font-size: 14px; color: var(--muted); max-width: 640px; }
  .lede strong { color: var(--fg); }
  .row { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px 24px; flex-wrap: wrap; }
  .clear { min-height: 32px; padding: 4px 12px; border-radius: 999px; border: 0; font-size: 13px; background: var(--info-ground); color: var(--info-ink); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 8px; margin-top: 4px; }
  .card { display: flex; flex-direction: column; gap: 10px; padding: 16px; border-radius: 14px; background: var(--card); min-width: 0; }
  .card.unscored { background: var(--inset); }
  .card.on { background: var(--info-ground); box-shadow: inset 0 0 0 1.5px var(--info); }
  .card-btn { display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100%; min-height: 32px; padding: 0; border: 0; background: transparent; text-align: left; }
  .card-t { font-size: 15px; font-weight: 650; }
  .card-s { display: flex; gap: 8px; align-items: center; }
  .ns { font-size: 11.5px; color: var(--faint); }
  .card p { font-size: 13.5px; color: var(--fg-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .k { font-size: 12px; color: var(--faint); margin-right: 2px; }
  .wchip { font-size: 12.5px; padding: 3px 10px; border-radius: 999px; background: var(--inset); color: var(--fg-2); text-decoration: none; }
  .wchip.hot { background: var(--accent-soft); color: var(--accent-ink); }
  .wchip .mono { font-size: 11.5px; opacity: 0.85; }
  .ev { display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 26px; padding: 0 6px; border-radius: 6px; background: var(--inset); color: var(--fg-2); font-family: var(--mono); font-size: 11.5px; text-decoration: none; }
  .ev:hover { background: var(--line-strong); }
  .none { font-size: 12px; color: var(--faint); }
  .area-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .achip { min-height: 36px; padding: 4px 12px; border-radius: 999px; border: 0; font-size: 13px; background: var(--card); color: var(--fg-2); }
  .achip[aria-pressed='true'], .barrow[aria-pressed='true'], .prow[aria-pressed='true'] { background: var(--info-ground); color: var(--info-ink); box-shadow: inset 0 0 0 1.5px var(--info); }
  .scroll { overflow-x: auto; }
  .grid { border-collapse: separate; border-spacing: 3px; min-width: 700px; width: 100%; font-size: 12.5px; }
  .grid th { font-weight: 500; color: var(--faint); text-align: center; font-size: 11.5px; padding: 0 4px; }
  .grid .corner { text-align: left; }
  .grid tbody th { text-align: left; }
  .prow { display: flex; justify-content: space-between; gap: 8px; width: 210px; min-height: 36px; padding: 0 10px; border: 0; border-radius: 8px; background: var(--card); color: var(--fg); font-size: 13px; text-align: left; }
  .pn { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cell { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 36px; border: 0; border-radius: 6px; font-family: var(--mono); font-size: 12.5px; color: var(--fg); background: var(--inset); }
  .cell.empty { background: transparent; box-shadow: inset 0 0 0 1px var(--line); }
  .s1 { background: #16233F; } .s2 { background: #22406F; } .s3 { background: #3A66B3; } .s4 { background: #5E9BFF; color: #06101F; }
  .cell.dim, .prow.dim, .barrow.dim, .achip.dim { opacity: 0.35; }
  .legend { display: flex; gap: 8px 10px; align-items: center; flex-wrap: wrap; font-size: 12px; color: var(--fg-2); }
  .ramp { display: flex; gap: 2px; } .ramp i { width: 18px; height: 10px; border-radius: 2px; }
  .faint { color: var(--faint); }
  .sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .sw.o { background: var(--accent); } .sw.d { background: #3A3A40; }
  .bars { display: flex; flex-direction: column; gap: 6px; }
  .barrow { display: grid; grid-template-columns: 200px minmax(0, 1fr) 40px; gap: 14px; align-items: center; min-height: 44px; padding: 8px 12px; border: 0; border-radius: 10px; background: var(--card); text-align: left; }
  .bl { display: flex; flex-direction: column; min-width: 0; }
  .bt { font-weight: 600; font-size: 14px; }
  .bm { font-size: 12px; color: var(--faint); }
  .track { display: flex; height: 22px; border-radius: 6px; overflow: hidden; gap: 2px; background: var(--inset); }
  .track .o { background: var(--accent); flex-grow: 0; flex-shrink: 0; }
  .track .d { background: #3A3A40; flex-grow: 0; flex-shrink: 0; }
  .bn { font-size: 12.5px; text-align: right; color: var(--faint); }
  .bn.hot { color: var(--accent-ink); }
  .split { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 6px; align-items: flex-start; }
  .listcol { flex: 3 1 400px; min-width: 0; }
  .listhead { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; font-size: 13px; color: var(--fg-2); }
  .done { min-height: 36px; padding: 4px 12px; border-radius: 999px; border: 0; font-size: 13px; background: var(--card); color: var(--fg-2); }
  .done[aria-pressed='true'] { background: var(--good-soft); color: var(--good-ink); }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .list li { scroll-margin-top: 16px; border-radius: 10px; }
  .rowbtn { display: flex; gap: 10px; align-items: flex-start; width: 100%; min-height: 44px; text-align: left; padding: 9px 10px; border: 0; border-radius: 10px; background: transparent; color: var(--fg-2); font-size: 13.5px; }
  .rowbtn:hover { background: var(--inset); }
  li.sel > .rowbtn { background: var(--card); color: var(--fg); }
  .rt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .meta { font-size: 12px; color: var(--faint); }
  .mark { flex: none; display: inline-block; margin-top: 5px; background: var(--accent); }
  .mark.closed { background: #5A5A63; }
  .mark.sq { width: 10px; height: 10px; border-radius: 2px; }
  .mark.dia { width: 9px; height: 9px; transform: rotate(45deg); }
  .mark.bar { width: 14px; height: 5px; border-radius: 2px; margin-top: 8px; }
  .detail { margin: 2px 0 10px 24px; padding: 14px 16px; border-radius: 12px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }
  :global(html.js-explore) .list .detail { display: none; }
  .side { flex: 2 1 280px; min-width: 0; position: sticky; top: 16px; }
  .side :global(.detail) { margin: 0; padding: 18px; border-radius: 14px; }
  .eyebrow2 { font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); font-weight: 600; }
  .dchips { display: flex; gap: 6px; flex-wrap: wrap; }
  .dt { font-size: 15.5px; font-weight: 600; line-height: 1.4; color: var(--fg); }
  blockquote { margin: 0; padding: 10px 12px; border-radius: 10px; background: var(--panel); font-size: 13.5px; color: var(--fg-2); }
  .matched { display: block; margin-top: 4px; font-size: 12px; color: var(--good-ink); }
  .who { font-size: 13px; color: var(--muted); }
  .who strong { color: var(--fg); }
  .stale { font-size: 12.5px; padding: 8px 10px; border-radius: 8px; background: var(--warn-soft); color: var(--warn); }
  .detail > a { font-size: 13px; }
  .nothing { padding: 14px; border-radius: 10px; background: var(--inset); font-size: 14px; color: var(--muted); }
  .linkbtn { border: 0; background: transparent; padding: 0; color: var(--link); text-decoration: underline; font-size: 14px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 640px) { .barrow { grid-template-columns: 1fr 40px; } .track { grid-column: 1 / -1; grid-row: 2; } .side { position: static; } }
</style>
