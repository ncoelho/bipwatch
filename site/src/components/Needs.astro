---
// What it needs: the overview above "What needs doing". One card per
// dimension with its score, a short rationale, the open items it covers
// (linked to their types of work below, through NEED_AREAS) and the claims
// the score rests on. Generated by `npm run needs` from this BIP's claims.
import { NEED_AREAS, NEED_DIMENSIONS, type BipBundle } from '@bipwatch/data';
import Dots from './Dots.astro';
import { AREA_LABEL, DIMENSION_LABEL, WORK_KINDS, isPending } from '../lib/view.ts';

interface Props { bundle: BipBundle; }
const { bundle } = Astro.props;
const { needs } = bundle;
const byId = new Map(bundle.claims.map((c) => [c.id, c]));
const open = bundle.claims.filter((c) => WORK_KINDS.includes(c.kind) && c.status !== 'addressed');
const openIn = (area: string) => open.filter((c) => c.area === area).length;
---
{needs && (
  <section id="needs-cards">
    <div class="sec-head">
      <h2>What it needs</h2>
      <p class="muted">
        Where BIP {bundle.bip.number} stands, scored 0 to 5 (5: no help needed), summarised from the claims on this page on {needs.assessed}.
        Each card links to its open work below and to the claims it rests on.
        {isPending(needs) && <span class="pill warn">Pending review</span>}
      </p>
    </div>
    <ul class="needs">
      {NEED_DIMENSIONS.map((dim) => {
        const d = needs.dimensions[dim];
        const areas = NEED_AREAS[dim].filter((a) => openIn(a) > 0);
        return (
          <li>
            <div class="need-top">
              <h3>{DIMENSION_LABEL[dim]}</h3>
              <Dots score={d.score} />
            </div>
            <p>{d.rationale}</p>
            {areas.length > 0 && (
              <p class="work">
                Open work: {areas.map((a, i) => <>{i > 0 && ' · '}<a href={`#work-${a}`}>{AREA_LABEL[a]} <span class="tnum">{openIn(a)}</span></a></>)}
              </p>
            )}
            {d.help_wanted?.length ? <ul class="asks">{d.help_wanted.map((h) => <li>{h}</li>)}</ul> : null}
            {d.evidence.length > 0 && (
              <p class="ev">
                Based on {d.evidence.map((id, i) => {
                  const c = byId.get(id);
                  return <>{i > 0 && ' '}<a href={`#${id}`} title={c?.statement ?? id}>{i + 1}</a></>;
                })}
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </section>
)}


<style>
  section { display: flex; flex-direction: column; gap: 16px; }
  .sec-head { display: flex; flex-direction: column; gap: 4px; }
  .sec-head h2 { font-size: 22px; }
  .sec-head p { font-size: 14px; max-width: 72ch; }
  .needs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .needs > li { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .need-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .need-top h3 { font-size: 15px; }
  .needs p { font-size: 14px; }
  .work { font-size: 13px !important; }
  .work a { color: var(--accent); text-decoration: none; white-space: nowrap; }
  .work a span { font-family: var(--mono); font-size: 11.5px; }
  .asks { margin: 0; padding-left: 18px; font-size: 13px; }
  .asks li::marker { color: var(--accent); }
  .ev { font-size: 12px !important; color: var(--faint); }
  .ev a { color: var(--muted); font-family: var(--mono); font-size: 11px; padding: 0 3px; border: 1px solid var(--line); border-radius: 3px; text-decoration: none; }
</style>
