---
// What needs doing (work page spec): every open task, open question and
// objection across tracked BIPs, by type of work, BIP and piece. Everything
// is derived at build time in lib/work.ts and rendered complete; without
// JavaScript every row shows its detail and the tiles and pieces are links
// to the filtered URL. lib/work-explorer.ts only filters, sorts,
// selects and mirrors the state in the query string.
//
// Rendering every row statically is fine at today's size. Past about 1,000
// items, show the first 200 in the current order with a "Show 200 more"
// button in work-explorer.ts.
import { canonicalName, loadAll, loadPeople } from '@bipwatch/data';
import Base from '../../layouts/Base.astro';
import { TIERS, TIER_HINT, TIER_LABEL } from '../../lib/triage.ts';
import { raisedLabel } from '../../lib/topics.ts';
import {
  AREA_HINT, age, areaLabel, pieceName, piecesLead, topPieces, usedAreas, workItems, workRows, workStats,
  type Area,
} from '../../lib/work.ts';

const today = new Date();
const all = loadAll();
const items = workItems(all, canonicalName(loadPeople()), today);
const stats = workStats(items, all, today);
const areas = usedAreas(items);
const pieces = topPieces(items, 10);
const maxPiece = Math.max(1, ...pieces.map((p) => p.open));
const bipsWithOpen = [...new Set(items.map((i) => i.bip))].sort((a, b) => a - b);
const titleOf = new Map(all.map((b) => [b.bip.number, b.bip.title]));
const built = today.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const short = (d?: string) => (d ? new Date(`${d}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : 'in the spec');
const aKey = (a: Area) => a || 'none';
const kindMark = (k: string) => (k === 'objection' ? 'sq' : k === 'open-question' ? 'dia' : 'bar');
const siblings = (key: string) => listRows.filter((r) => r.lead.pieceKey === key).length;
// One row per request: items in a topic (topics.yaml) show once.
const listRows = workRows(items, all);
const KINDS = [
  { key: '', label: 'All' },
  { key: 'task', label: 'Tasks' },
  { key: 'open-question', label: 'Open questions' },
  { key: 'objection', label: 'Objections' },
] as const;
// Priority groups: the list opens on the first group that has items.
const firstTier = TIERS.find((t) => items.some((i) => i.tier === t)) ?? 'attention';
---
<Base title="What needs doing · BipWatch" current="work" description="Every open task, open question and objection across the BIPs BipWatch tracks, by type of work, BIP and piece. Each links to where it was raised.">
  <div class="shell page" data-work>
    <header class="top">
      <div class="tt">
        <div class="eyebrow">What needs doing · {stats.tracked} tracked BIPs</div>
        <h1><span class="num mono">{stats.open}</span> open items that would move a BIP forward</h1>
        <p class="lead">Tasks, open questions and objections raised in public discussion, sorted by the kind of contributor who could pick them up. Each one links to where it was raised.</p>
      </div>
      <div class="chips">
        <span class="pill good">Live data · {built}</span>
        {stats.pending && <span class="pill warn">Pending review</span>}
      </div>
    </header>

    <div class="tiles">
      <div class="tile hot"><span class="k">Open items</span><span class="v mono">{stats.open}</span><span class="s">{stats.tasks} tasks · {stats.questions} questions · {stats.objections} objections</span></div>
      <div class="tile"><span class="k">BIPs with open work</span><span class="v mono">{stats.withOpen} of {stats.tracked}</span><span class="s">{stats.nothingOpen.length ? `${stats.nothingOpen.map((n) => `BIP ${n}`).join(', ')}: nothing open` : 'every tracked BIP has open work'}</span></div>
      <div class="tile"><span class="k">Raised in the last 30 days</span><span class="v mono">{stats.recent}</span><span class="s">{stats.newest ? `newest ${short(stats.newest)}` : 'none dated'}</span></div>
      <div class="tile old"><span class="k">Raised over 2 years ago</span><span class="v mono">{stats.old}</span><span class="s">{stats.old ? `${stats.oldByBip.slice(0, 3).map(([b, n]) => `BIP ${b} ${n}`).join(' · ')}${stats.oldByBip.length > 3 ? ' …' : ''} · may be settled or obsolete` : 'none'}</span></div>
      <div class="tile"><span class="k">Already addressed</span><span class="v mono">{stats.addressed}</span><span class="s">across the same BIPs</span></div>
    </div>

    <section class="skills" aria-labelledby="h-skills">
      <div class="eyebrow">Start from your skills</div>
      <h2 id="h-skills">What can you help with?</h2>
      <div class="roles" role="group" aria-label="Type of work">
        <a href="?#list" class="role" data-area-tile="">
          <span class="rh"><span class="rl">Everything</span><span class="rc mono hot" data-count>{items.length}</span></span>
          <span class="rhint">All types of work</span>
        </a>
        {areas.map((a) => {
          const n = items.filter((i) => i.area === a).length;
          return (
            <a href={`?area=${aKey(a)}#list`} class="role" data-area-tile={aKey(a)}>
              <span class="rh"><span class="rl">{areaLabel(a)}</span><span class:list={['rc', 'mono', { hot: n > 0 }]} data-count>{n}</span></span>
              <span class="rhint">{AREA_HINT[aKey(a) as keyof typeof AREA_HINT]}</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="panel" id="list" aria-labelledby="h-list">
      <div class="lh">
        <h2 id="h-list"><span data-list-title>Open work</span> <span class="sub">· <span data-list-count>{items.length}</span> open</span></h2>
        <button type="button" class="clear" data-clear hidden>Show all ✕</button>
      </div>
      <div class="tiers-wrap">
        <div class="tiers" role="group" aria-label="Priority" data-first-tier={firstTier}>
          {TIERS.map((t) => (
            <button type="button" class:list={['tbtn', t]} data-tier-pill={t} aria-pressed={t === firstTier ? 'true' : 'false'} title={TIER_HINT[t]}>{TIER_LABEL[t]} <span class="mono tn" data-count>{items.filter((i) => i.tier === t).length}</span></button>
          ))}
          <button type="button" class="tbtn" data-tier-pill="all" aria-pressed="false">All <span class="mono tn" data-count>{items.length}</span></button>
        </div>
        <p class="tier-hint"><span data-tier-hint>{TIER_HINT[firstTier]}</span>. Grouped by BipWatch from the type of work, each BIP's needs scores and status, and the item's age, unless a person set the group; nobody has reviewed these items yet.</p>
      </div>
      <div class="controls">
        <div class="left">
          <label class="bipsel">
            <span>BIP</span>
            <span class="selwrap">
              <select data-bip-select>
                <option value="">All BIPs · {items.length} open</option>
                {bipsWithOpen.map((b) => <option value={String(b)}>BIP {b} · {titleOf.get(b)} · {items.filter((i) => i.bip === b).length} open</option>)}
              </select>
              <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </label>
          <div class="kinds" role="group" aria-label="Filter by kind">
            {KINDS.map((k) => (
              <button type="button" class="kpill" data-kind-pill={k.key} aria-pressed={k.key === '' ? 'true' : 'false'}>
                {k.key && <span class:list={['mark', kindMark(k.key)]} aria-hidden="true"></span>}
                {k.label} <span class="mono kn" data-count>{k.key ? items.filter((i) => i.kind === k.key).length : items.length}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="sort" role="group" aria-label="Sort">
          <button type="button" data-sort="new" aria-pressed="true">Newest</button>
          <button type="button" data-sort="old" aria-pressed="false">Oldest</button>
          <button type="button" data-sort="bip" aria-pressed="false">By BIP</button>
        </div>
      </div>

      <div class="split">
        <div class="listcol">
          <ol class="list" data-list>
            {listRows.map((r) => {
              const i = r.lead;
              const raised = raisedLabel(r);
              const title = r.topic?.title ?? i.statement;
              return (
              <li id={`w-${i.id}`} data-row data-id={i.id} data-members={r.others.map((o) => o.id).join(' ') || undefined} data-bip={i.bip} data-area={aKey(i.area)} data-piece={i.pieceKey} data-piece-name={i.piece} data-kind={i.kind} data-tier={i.tier} data-date={i.date ?? ''}>
                <button type="button" class="rowbtn" data-select aria-pressed="false">
                  <span class:list={['mark', kindMark(i.kind)]} aria-hidden="true"></span>
                  <span class="rt">
                    <span class="rmeta">
                      <span class="bchip mono">BIP {i.bip}</span>
                      <span class="pc">{i.piece || 'the BIP itself'}</span>
                      <span class:list={['age', 'mono', { oldage: i.old }]}>{age(i.date, today)}</span>
                    </span>
                    <span class="st">{title}</span>
                    <span class="why"><span class:list={['tchip', i.tier, { chosen: i.chosen }]}>{TIER_LABEL[i.tier]}</span>{raised && <span class="times">{raised}</span>}{i.reasons.map((x) => <span class="reason">{x}</span>)}</span>
                    <span class="meta">{i.kindLabel} · {i.areaLabel} · {i.who} · {i.venue}{i.status === 'unknown' ? ' · status unknown' : ''}{i.old ? ' · may be out of date' : ''}</span>
                  </span>
                </button>
                <div class="detail">
                  <div class="dbip"><span class="mono">BIP {i.bip}</span><span>{i.bipTitle}</span></div>
                  <div class="eyebrow2">{pieceName(i.piece, i.bip)}</div>
                  <div class="dchips">
                    <span class="pill">{i.kindLabel}</span>
                    <span class="pill accent">{i.areaLabel}</span>
                    <span class:list={['pill', { warn: i.status === 'unknown' }]}>{i.status === 'unknown' ? 'Status unknown' : 'Open'}</span>
                    {i.pending && <span class="pill warn">pending review</span>}
                  </div>
                  <div class="dt">{title}</div>
                  <div class="dwhy"><span class:list={['tchip', i.tier]}>{TIER_LABEL[i.tier]}</span> {[raised, ...i.reasons].filter(Boolean).join(' · ')}</div>
                  {r.others.length > 0 ? (
                    <>
                      <div class="mhead">Grouped as one request by BipWatch, not yet reviewed. Each message:</div>
                      <ol class="mentions">
                        {[i, ...r.others].map((x) => (
                          <li>
                            <p>{x.statement}</p>
                            {x.quote && <blockquote>“{x.quote}”<span class:list={['q', { ok: x.quoteMatched }]}>{x.quoteMatched ? 'quote matched' : 'quote not matched yet'}</span></blockquote>}
                            <div class="who"><strong>{x.who}</strong> · {short(x.date)} · {x.venue}{x.venueTitle ? ` · ${x.venueTitle}` : ''} · <a href={x.url} rel="noopener">Open the message</a></div>
                          </li>
                        ))}
                      </ol>
                    </>
                  ) : (
                    <>
                      {i.quote && (
                        <blockquote>“{i.quote}”<span class:list={['q', { ok: i.quoteMatched }]}>{i.quoteMatched ? 'quote matched' : 'quote not matched yet'}</span></blockquote>
                      )}
                      <div class="who">Raised by <strong>{i.who}</strong> · {short(i.date)} · {i.venue}{i.venueTitle ? ` · ${i.venueTitle}` : ''}</div>
                    </>
                  )}
                  {i.old && <div class="warnbox">Raised {age(i.date, today)} ago on a BIP that is now {i.bipStatus}, with no later discussion recorded. It may be settled or obsolete: check the thread before picking it up.</div>}
                  {i.stale && <div class="warnbox">Raised against {i.staleLabel}; the spec is now at v{i.bipVersion}. Check it still applies.</div>}
                  <div class="actions">
                    <a class="btn primary" href={i.url} rel="noopener">Join the discussion</a>
                    <a class="btn" href={i.bipHref}>See it on BIP {i.bip}</a>
                  </div>
                  {siblings(i.pieceKey) > 1 && (
                    <a class="sib" href={`?piece=${encodeURIComponent(i.pieceKey)}#list`} data-piece-link={i.pieceKey}>{siblings(i.pieceKey) - 1} more open on {pieceName(i.piece, i.bip)} →</a>
                  )}
                  <div class="foot">Nobody is assigned to items here. Reply where it was raised so the authors know someone is on it.</div>
                </div>
              </li>
              );
            })}
          </ol>
          <div class="nothing" data-nothing hidden>Nothing open matches these filters. <button type="button" class="linkbtn" data-clear-inline>Show everything</button></div>
        </div>
        <div class="side" role="region" aria-label="Selected item" aria-live="polite" data-panel hidden></div>
      </div>
    </section>

    <div class="section-head">
      <div class="eyebrow">Across all tracked BIPs</div>
      <h2 id="h-pieces">Biggest open pieces</h2>
      <p class="lead">{piecesLead(items)} Pick one to filter the list above.</p>
    </div>

    <section class="panel" aria-labelledby="h-pieces">
      <div class="pieces">
        {pieces.map((p) => (
          <a href={`?piece=${encodeURIComponent(p.key)}#list`} class="prow" data-piece-row={p.key} data-bip={p.bip}>
            <span class="pl"><span class="pt">{pieceName(p.piece, p.bip)}</span><span class="pm">BIP {p.bip} · {p.topAreas.map(([a, n]) => `${areaLabel(a)} ${n}`).join(' · ')}</span></span>
            <span class="pbar"><span style={`width:${((p.open / maxPiece) * 100).toFixed(1)}%`}></span></span>
            <span class="pn mono">{p.open}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  import { initWorkExplorer } from '../../lib/work-explorer.ts';
  initWorkExplorer();
</script>

<style>
  .page { display: flex; flex-direction: column; }
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 24px; flex-wrap: wrap; }
  .tt { display: flex; flex-direction: column; gap: 12px; min-width: 0; max-width: 820px; }
  h1 { font-size: clamp(38px, 6vw, 60px); font-weight: 650; letter-spacing: -0.03em; line-height: 1.02; }
  h1 .num { font-weight: 500; color: var(--accent-ink); letter-spacing: -0.04em; }
  .lead { color: var(--muted); font-size: 16px; max-width: 680px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; margin-top: 24px; }
  .tile { background: var(--panel); border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px; }
  .tile.hot { background: var(--accent-ground); }
  .tile.old { background: #1A1709; }
  .k { font-size: 12px; color: var(--faint); }
  .hot .k, .hot .v { color: var(--accent-ink); }
  .old .k, .old .v { color: var(--warn); }
  .v { font-size: 28px; font-weight: 600; }
  .s { font-size: 12.5px; color: var(--muted); }
  .hot .s { color: #F2D9C4; }
  .skills { margin-top: 56px; }
  .skills h2, .section-head h2 { margin-top: 6px; font-size: 34px; letter-spacing: -0.02em; line-height: 1.12; }
  .roles { display: grid; grid-template-columns: repeat(auto-fit, minmax(176px, 1fr)); gap: 8px; margin-top: 20px; }
  .role { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 14px 16px; border-radius: 14px; min-height: 80px; background: var(--panel); color: var(--fg); text-decoration: none; }
  .role[aria-pressed='true'] { background: var(--info-ground); box-shadow: inset 0 0 0 1.5px var(--info); }
  /* Empty: dimmed by colour, not opacity, so the text keeps 4.5:1. */
  .role.zero { background: transparent; box-shadow: inset 0 0 0 1px var(--card); color: var(--faint); }
  .role.zero .rl { font-weight: 500; }
  .role.zero[aria-disabled='true'] { cursor: default; }
  .rh { display: flex; justify-content: space-between; align-items: center; gap: 8px; width: 100%; }
  .rl { font-size: 15px; font-weight: 600; }
  .rc { font-size: 14px; padding: 1px 9px; border-radius: 999px; background: var(--card); color: var(--faint); }
  .rc.hot { background: var(--accent-soft); color: var(--accent-ink); }
  .role[aria-pressed='true'] .rc { background: var(--info); color: #06101F; font-weight: 600; }
  .rhint { font-size: 12.5px; color: var(--faint); }
  .role[aria-pressed='true'] .rhint { color: var(--info-ink); }
  .panel { margin-top: 20px; background: var(--panel); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 16px; }
  .panel h2 { font-size: 17px; }
  .sub { font-weight: 400; color: var(--faint); font-size: 14px; }
  .lh { display: flex; justify-content: space-between; align-items: center; gap: 10px 16px; flex-wrap: wrap; }
  .clear { min-height: 32px; padding: 4px 12px; border-radius: 999px; border: 0; font-size: 13px; background: var(--info-ground); color: var(--info-ink); }
  .controls { display: flex; justify-content: space-between; gap: 10px 16px; flex-wrap: wrap; align-items: center; }
  .left { display: flex; gap: 10px 16px; flex-wrap: wrap; align-items: center; min-width: 0; }
  .bipsel { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--faint); max-width: 100%; }
  .selwrap { position: relative; display: inline-flex; align-items: center; max-width: 100%; }
  select { appearance: none; -webkit-appearance: none; height: 40px; padding: 0 36px 0 14px; border-radius: 10px; border: 0; font: inherit; font-size: 14px; min-width: 280px; max-width: 100%; cursor: pointer; background: var(--card); color: var(--fg); }
  select.on { background: var(--info-ground); color: var(--info-ink); font-weight: 600; }
  select option { background: var(--card); color: var(--fg); }
  .chev { position: absolute; right: 12px; pointer-events: none; color: var(--muted); }
  .kinds { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .kpill { display: inline-flex; align-items: center; gap: 7px; min-height: 32px; padding: 4px 12px; border-radius: 999px; border: 0; font-size: 13px; background: var(--card); color: var(--fg-2); }
  .kpill[aria-pressed='true'] { background: var(--fg); color: #000; font-weight: 600; }
  /* Priority groups (lib/triage.ts). */
  .tiers-wrap { display: flex; flex-direction: column; gap: 8px; }
  .tiers { display: flex; flex-wrap: wrap; gap: 6px; }
  .tbtn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border: 0; border-radius: 12px; background: var(--card); color: var(--fg-2); font: inherit; font-size: 14px; cursor: pointer; }
  .tbtn:hover { color: var(--fg); }
  .tn { font-size: 12px; color: var(--faint); }
  .tbtn.attention .tn { color: var(--accent-ink); }
  .tbtn[aria-pressed='true'] { background: var(--info-ground); color: var(--info-ink); box-shadow: inset 0 0 0 1.5px var(--info); font-weight: 600; }
  .tbtn[aria-pressed='true'] .tn { color: var(--info-ink); }
  .tier-hint { font-size: 12.5px; color: var(--muted); }
  .why { display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
  .reason { font-size: 12px; color: var(--muted); }
  .reason + .reason::before { content: '· '; color: var(--faint); }
  .tchip { font-size: 11.5px; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--inset); color: var(--muted); }
  .tchip.attention { background: var(--accent-soft); color: var(--accent-ink); }
  .tchip.important { background: var(--info-ground); color: var(--info-ink); }
  .tchip.chosen { box-shadow: inset 0 0 0 1.5px currentColor; }
  .times { font-size: 12px; font-weight: 600; color: var(--fg-2); }
  .times + .reason::before { content: '· '; color: var(--faint); }
  .mhead { font-size: 12.5px; color: var(--muted); }
  .mentions { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .mentions > li { background: var(--inset); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; }
  .dwhy { font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .kn { font-size: 11.5px; opacity: 0.8; }
  .sort { display: flex; gap: 4px; padding: 3px; border-radius: 999px; background: var(--card); }
  .sort button { min-height: 32px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 13px; }
  .sort button[aria-pressed='true'] { background: var(--fg); color: #000; font-weight: 600; }
  .mark { flex: none; display: inline-block; background: var(--accent); }
  .mark.sq { width: 10px; height: 10px; border-radius: 2px; }
  .mark.dia { width: 9px; height: 9px; transform: rotate(45deg); }
  .mark.bar { width: 14px; height: 5px; border-radius: 2px; }
  .split { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; }
  .listcol { flex: 3 1 460px; min-width: 0; }
  .list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  :global(html.js-work) .list { max-height: 720px; overflow-y: auto; }
  .list li { scroll-margin-top: 16px; }
  .rowbtn { display: flex; gap: 12px; align-items: flex-start; width: 100%; min-height: 44px; text-align: left; padding: 10px 12px; border-radius: 10px; border: 0; background: transparent; color: var(--fg-2); }
  .rowbtn:hover { background: var(--inset); }
  .rowbtn .mark { margin-top: 6px; }
  .rowbtn .mark.bar { margin-top: 9px; }
  li.sel > .rowbtn { background: var(--card); color: var(--fg); box-shadow: inset 0 0 0 1px var(--info); }
  .rt { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1 1 auto; }
  .rmeta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .bchip { font-size: 12px; padding: 1px 8px; border-radius: 999px; background: var(--line-strong); color: var(--fg-2); }
  .pc { font-size: 12px; color: var(--muted); }
  .age { font-size: 11.5px; margin-left: auto; color: var(--faint); }
  .age.oldage { padding: 1px 7px; border-radius: 999px; background: var(--warn-soft); color: var(--warn); }
  .st { font-size: 14px; line-height: 1.4; }
  .meta { font-size: 12px; color: var(--faint); }
  .detail { margin: 2px 0 12px 26px; padding: 16px 18px; border-radius: 14px; background: var(--card); display: flex; flex-direction: column; gap: 12px; }
  :global(html.js-work) .list .detail { display: none; }
  .side { flex: 2 1 300px; min-width: 0; position: sticky; top: 16px; }
