---
import { loadAll } from '@bipwatch/data';
import Base from '../../layouts/Base.astro';
import Frame from '../../templates/Frame.astro';

export function getStaticPaths() {
  const all = loadAll();
  const known = new Set(all.map((b) => b.bip.number));
  return all.map((bundle) => ({ params: { number: String(bundle.bip.number) }, props: { bundle, known } }));
}

const { bundle, known } = Astro.props;
const { bip } = bundle;

---
<Base title={`BIP ${bip.number}: ${bip.title} · BipWatch`} description={bip.bipwatch.summary} current="proposals">
  <Frame bundle={bundle} known={known} />
</Base>
