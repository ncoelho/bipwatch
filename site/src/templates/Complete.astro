---
// Stage template for Complete BIPs. What still needs doing leads (the site's
// main job); then "is it getting built?" with implementations near the top,
// and the problem statement and trade-offs after.
import type { BipBundle } from '@bipwatch/data';
import Implementations from '../components/Implementations.astro';
import Needs from '../components/Needs.astro';
import OpenWork from '../components/OpenWork.astro';
import Positions from '../components/Positions.astro';
import Source from '../components/Source.astro';
import {
  CATEGORY_LABEL,
  bipHref, byKind, isPending, pad,
} from '../lib/view.ts';

interface Props { bundle: BipBundle; known: Set<number>; }
const { bundle, known } = Astro.props;
const { bip, needs } = bundle;

const problems = byKind(bundle, 'problem');
const tradeoffs = byKind(bundle, 'tradeoff');
const evidence = byKind(bundle, 'evidence');
const pendingCount = bundle.claims.filter(isPending).length;

const bipLink = (n: number) => (known.has(n) ? bipHref(n) : `https://github.com/bitcoin/bips/blob/master/bip-${pad(n)}.mediawiki`);
---
<article class="shell page">
  <header class="hero">
    <span class="eyebrow">BIP {bip.number} · {bip.layer ?? 'No layer'}</span>
    <h1>{bip.title}</h1>
    <div class="pills">
      <span class="pill">Official status: {bip.status}</span>
      {bip.bipwatch.category && <span class="pill accent">{CATEGORY_LABEL[bip.bipwatch.category]}</span>}
      {bip.version && <span class="pill">v{bip.version}</span>}
      {bip.bipwatch.adoption_measure === 'wallet-coverage' && <span class="pill layer">Adoption measured by wallet coverage</span>}
    </div>
    {bip.bipwatch.summary && <p class="lede">{bip.bipwatch.summary}</p>}
    <dl class="facts">
      <div><dt>Authors</dt><dd>{bip.authors.join(', ')}</dd></div>
      {bip.assigned && <div><dt>Assigned</dt><dd class="tnum">{bip.assigned}</dd></div>}
      {bip.requires?.length ? <div><dt>Requires</dt><dd>{bip.requires.map((n, i) => <>{i > 0 && ', '}<a href={bipLink(n)}>BIP {n}</a></>)}</dd></div> : null}
      {bip.related?.length ? <div><dt>Companions</dt><dd>{bip.related.map((n, i) => <>{i > 0 && ', '}<a href={bipLink(n)}>BIP {n}</a></>)}</dd></div> : null}
    </dl>
    {pendingCount > 0 && (
      <p class="notice">{pendingCount} of {bundle.claims.length} claims on this page are pending review. They were extracted automatically and link to their sources.</p>
    )}
  </header>

  <Needs bundle={bundle} />

  <OpenWork bundle={bundle} />


  <Implementations bundle={bundle} />

  <Positions bundle={bundle} />

  {problems.length > 0 && (
    <section id="problem">
      <div class="sec-head"><h2>Why it exists</h2></div>
      <ul class="claims">
        {problems.map((c) => <li id={c.id}><p>{c.statement}</p><Source claim={c} /></li>)}
      </ul>
    </section>
  )}

  {tradeoffs.length > 0 && (
    <section id="tradeoffs">
      <div class="sec-head"><h2>Trade-offs</h2></div>
      <ul class="claims">
        {tradeoffs.map((c) => <li id={c.id}><p>{c.statement}</p><Source claim={c} /></li>)}
      </ul>
    </section>
  )}

  {evidence.length > 0 && (
    <section id="evidence">
      <div class="sec-head"><h2>Evidence</h2></div>
      <ul class="claims">
        {evidence.map((c) => <li id={c.id}><p>{c.statement}</p><Source claim={c} /></li>)}
      </ul>
    </section>
  )}

  {bip.discussion?.length ? (
    <section id="discussion">
      <div class="sec-head"><h2>Discussion history</h2><p class="muted">From the spec's Discussion header.</p></div>
      <ol class="timeline">
        {bip.discussion.map((d) => (
          <li><span class="mono tnum">{d.date ?? '–'}</span><a href={d.url} rel="noopener">{d.title ?? new URL(d.url).hostname}</a></li>
        ))}
      </ol>
    </section>
  ) : null}

  <aside class="spec-note">
    Synced against <a href={`https://github.com/${bip.spec.repo}/blob/${bip.spec.revision}/${bip.spec.path}`} class="mono">{bip.spec.path}@{bip.spec.revision.slice(0, 7)}</a> on {bip.spec.synced}.
    Raw data: <a href={`/api/bips/${bip.number}.json`}>/api/bips/{bip.number}.json</a>
  </aside>
</article>

<style>
  .page { display: flex; flex-direction: column; gap: 48px; }
  .hero { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  .hero h1 { font-size: clamp(32px, 5vw, 48px); line-height: 1.05; letter-spacing: -0.02em; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .lede { font-size: 17px; color: var(--muted); max-width: 64ch; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px 24px; margin: 4px 0 0; }
  .facts div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }
  dd { margin: 0; font-size: 14px; }
  .notice { font-size: 13px; color: var(--accent); background: var(--accent-soft); border-radius: 8px; padding: 10px 12px; }

  section { display: flex; flex-direction: column; gap: 16px; }
  .sec-head { display: flex; flex-direction: column; gap: 4px; }
  .sec-head h2 { font-size: 22px; }
  .sec-head p { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; }



  .claims { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; max-width: 760px; }
  .claims > li { padding: 16px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; scroll-margin-top: 24px; }
  .claims > li:first-child { padding-top: 0; }
  .claims > li:target { background: var(--accent-soft); padding-inline: 12px; border-radius: 8px; }

  .timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
  .timeline li { display: grid; grid-template-columns: 96px 1fr; gap: 12px; font-size: 14px; }
  .timeline a { overflow-wrap: anywhere; }
  .timeline span { color: var(--faint); font-size: 13px; }

  .spec-note { font-size: 13px; color: var(--faint); border-top: 1px solid var(--line); padding-top: 16px; overflow-wrap: anywhere; }
  @media (max-width: 520px) { .timeline li { grid-template-columns: 1fr; gap: 0; } }
</style>
