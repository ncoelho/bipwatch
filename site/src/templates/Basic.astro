---
// Fallback for BIPs without a stage template: untracked companions, and tracked
// BIPs whose stage template is not built yet (only `complete` exists).
import type { BipBundle } from '@bipwatch/data';
import Implementations from '../components/Implementations.astro';
import Needs from '../components/Needs.astro';
import OpenWork from '../components/OpenWork.astro';
import Positions from '../components/Positions.astro';
import { CATEGORY_LABEL, bipHref, pad } from '../lib/view.ts';

interface Props { bundle: BipBundle; known: Set<number>; }
const { bundle, known } = Astro.props;
const { bip } = bundle;
const link = (n: number) => (known.has(n) ? bipHref(n) : `https://github.com/bitcoin/bips/blob/master/bip-${pad(n)}.mediawiki`);
const specUrl = `https://github.com/${bip.spec.repo}/blob/${bip.spec.revision}/${bip.spec.path}`;
---
<article class="shell page">
  <span class="eyebrow">BIP {bip.number} · {bip.layer ?? 'No layer'}</span>
  <h1>{bip.title}</h1>
  <div class="pills">
    <span class="pill">Official status: {bip.status}</span>
    {bip.bipwatch.category && <span class="pill accent">{CATEGORY_LABEL[bip.bipwatch.category]}</span>}
    {bip.version && <span class="pill">v{bip.version}</span>}
  </div>
  {bip.bipwatch.tracked && bip.bipwatch.summary && <p class="lede">{bip.bipwatch.summary}</p>}
  <p class="muted">Authors: {bip.authors.join(', ')}{bip.assigned && ` · assigned ${bip.assigned}`}</p>
  {bip.requires?.length ? (
    <p class="muted">Requires {bip.requires.map((n, i) => <>{i > 0 && ', '}<a href={link(n)}>BIP {n}</a></>)}</p>
  ) : null}
  {bip.bipwatch.tracked ? (
    <p class="note">BipWatch tracks this proposal. Its full page isn't built yet, so this shows the spec header, summary and the evidence gathered so far. <a href={specUrl}>Read the spec</a>.</p>
  ) : (
    <p class="note">BipWatch doesn't track this proposal in depth yet, so this page only shows its spec header. <a href={specUrl}>Read the spec</a>.</p>
  )}
  <Needs bundle={bundle} />
  <OpenWork bundle={bundle} />
  <Implementations bundle={bundle} />
  <Positions bundle={bundle} />
</article>

<style>
  .page { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  h1 { font-size: clamp(28px, 4.5vw, 40px); line-height: 1.1; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .lede { font-size: 17px; color: var(--muted); max-width: 64ch; }
  .note { margin-top: 12px; padding: 12px 14px; border: 1px dashed var(--line-strong); border-radius: 8px; color: var(--muted); font-size: 14px; }
</style>
