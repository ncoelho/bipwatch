# Copy to .env (git-ignored) and fill in, or run `neon env pull` to get .env.local.
# Neon connection string, e.g. postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/bipwatch?sslmode=require
DATABASE_URL=
# Direct (non-pooler) endpoint for migrations. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Needed by the github collector.
GITHUB_TOKEN=
