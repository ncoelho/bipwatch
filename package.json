{
  "name": "bipwatch",
  "private": true,
  "version": "0.1.0",
  "description": "An open layer of data, metadata and evidence on top of the Bitcoin BIP repository.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "validate": "npm run validate --workspace @bipwatch/data --",
    "dev": "npm run dev --workspace site",
    "build": "npm run validate && npm run build --workspace site",
    "test": "npm test --workspaces --if-present",
    "migrate": "npm run migrate --workspace @bipwatch/collect --",
    "collect": "npm run collect --workspace @bipwatch/collect --",
    "sync-headers": "npm run sync-headers --workspace @bipwatch/collect --",
    "freshness": "npm run freshness --workspace @bipwatch/collect --",
    "extract": "npm run extract --workspace @bipwatch/extract --",
    "reindex-mentions": "npm run reindex-mentions --workspace @bipwatch/collect --",
    "freshness:snapshot": "npm run freshness --silent -- --export data/freshness.json --optional",
    "predev": "npm run freshness:snapshot",
    "prebuild": "npm run freshness:snapshot",
    "tracked-bips": "npm run --silent tracked --workspace @bipwatch/data",
    "relabel-areas": "npm run relabel-areas --workspace @bipwatch/extract --",
    "needs": "npm run needs --workspace @bipwatch/extract --",
    "repin-versions": "npm run repin-versions --workspace @bipwatch/extract --"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=11.21.1"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15"
  },
  "packageManager": "npm@11.21.1"
}
