{
  "name": "@bipwatch/extract",
  "version": "0.1.0",
  "private": true,
  "description": "LLM extractors that propose claims from the archive (SPEC 6.2).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "extract": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --env-file-if-exists=../../.env.anthropic src/cli.ts",
    "relabel-areas": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --env-file-if-exists=../../.env.anthropic src/relabel-areas.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "needs": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --env-file-if-exists=../../.env.anthropic src/needs-cli.ts",
    "repin-versions": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env --env-file-if-exists=../../.env.anthropic src/repin-versions.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@bipwatch/collect": "*",
    "@bipwatch/data": "*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.13.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.11.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  }
}
