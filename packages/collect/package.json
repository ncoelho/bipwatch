{
  "name": "@bipwatch/collect",
  "version": "0.1.0",
  "private": true,
  "description": "Collectors, raw archive and BIP-mention index for BipWatch.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "collect": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/cli.ts",
    "migrate": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:db": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run test/db.integration.test.ts",
    "sync-headers": "tsx src/sync-headers.ts",
    "freshness": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/freshness.ts",
    "reindex-mentions": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../.env src/reindex.ts"
  },
  "dependencies": {
    "@bipwatch/data": "*",
    "pg": "8.13.1",
    "postal-mime": "2.4.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/pg": "8.11.10",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  }
}
